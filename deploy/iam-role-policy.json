{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GlobeFramePhotoObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::globeframe-photos-2026/photos/*"
    },
    {
      "Sid": "GlobeFrameListBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::globeframe-photos-2026"
    }
  ]
}
